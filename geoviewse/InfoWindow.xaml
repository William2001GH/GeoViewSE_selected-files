<Window x:Class="GeoViewSE_Linnaeus.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Information" Height="400" Width="300">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <Button Content="Fråga Hjälpredan"
        Margin="0,8,0,0"
        Click="AskCopilot_Click"/>
            <Button Content="Play" Click="PlaySound_Click" />
            <Button x:Name="CopyButton"
        Content="Kopiera data"
        Width="120"
        Height="28"
        Margin="0,5,0,0"
        Click="CopyButton_Click"/>



            <TextBlock x:Name="TitleText"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0 0 0 10"/>
        <Image x:Name="CategoryIcon" Width="24" Height="24" Margin="0 0 8 0"/>

        <TextBlock x:Name="CategoryText"
                   FontSize="14"
                   Margin="0 0 0 10"/>

        <TextBlock x:Name="DescriptionText"
                   TextWrapping="Wrap"
                   Margin="0 0 0 10"/>

        <Image x:Name="PlaceImage"
               Height="200"
               Stretch="Uniform"/>

        <Button x:Name="OpenInGoogleMaps"
        Content="Öppna i Google Maps"
        Margin="0 0 0 10"
        Click="OpenInGoogleMaps_Click"/>

        <TextBlock x:Name="CoordText"
           FontSize="12"
           Margin="0 0 0 10"
           Foreground="Gray"/>

        <TextBlock x:Name="EnvironmentalText"
           FontSize="12"
           Margin="0 0 0 10"
           Foreground="Gray"
           TextWrapping="Wrap"
           MaxWidth="260"/>

        <Button Content="Kontakta utvecklare"
           Margin="0 0 0 10"
           Click="ContactDeveloper_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>

